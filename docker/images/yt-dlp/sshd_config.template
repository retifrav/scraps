Port $SSH_PORT
PidFile ${NON_ROOT_SSH_FOLDER}/sshd.pid

# generated by `entrypoint.sh` on the first start, so they are not
# shared by everyone who pulls the image
HostKey ${NON_ROOT_SSH_FOLDER}/keys/ssh_host_ed25519_key
HostKey ${NON_ROOT_SSH_FOLDER}/keys/ssh_host_rsa_key

PermitRootLogin no
PermitEmptyPasswords no
PasswordAuthentication no
# `ChallengeResponseAuthentication` is the deprecated name of this one
KbdInteractiveAuthentication no
PubkeyAuthentication yes
# `%h` is expanded by sshd to the home directory of the user logging in, so this
# does not have to be templated with the user name
AuthorizedKeysFile %h/.ssh/authorized_keys
#UsePAM no

Subsystem sftp /usr/lib/ssh/sftp-server
